{
  "expo": {
    "name": "Bridee",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bridee.ios"
    },
    "android": {
      "package": "app.bridee.android",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "bridee",
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "googleWebClientId": "307192875715-rps1hkvsmmjmtl0ufi905ogbikpqq7lt.apps.googleusercontent.com",
      "eas": {
        "projectId": "29593401-d85b-47c1-b220-055616c61d75"
      }
    }
  }
}
